name: 🚀 Deploy to Shopify

on:
  push:
    branches:
      - main
    paths:
      - 'theme/**'
      - '.github/workflows/deploy-to-shopify.yml'

jobs:
  deploy:
    runs-on: ubuntu-latest
    
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v3

      - name: 🟢 Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'

      - name: 📦 Install Shopify CLI
        run: npm install -g @shopify/cli

      - name: 🔑 Configure Shopify Credentials
        run: |
          echo "SHOPIFY_CLI_AUTH_TOKEN=${{ secrets.SHOPIFY_ADMIN_TOKEN }}" >> $GITHUB_ENV
          echo "SHOP_NAME=${{ secrets.SHOPIFY_SHOP_URL }}" >> $GITHUB_ENV

      - name: 🧪 Validate theme
        run: shopify theme check ./theme

      - name: 🚀 Deploy theme to Shopify
        run: |
          cd theme
          shopify theme push --store=${{ secrets.SHOPIFY_SHOP_URL }} --force

      - name: ✅ Deployment Success
        run: echo "✅ Theme deployed successfully to ${{ secrets.SHOPIFY_SHOP_URL }}"

