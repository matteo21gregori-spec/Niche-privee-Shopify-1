<section class="collection-section">
  <div class="collection-header">
    <h1>{{ collection.title }}</h1>
    <p>{{ collection.description }}</p>
  </div>
  
  <div class="collection-container">
    <aside class="filters">
      <h3>Filters</h3>
      <!-- Filter options can be added here -->
    </aside>
    
    <div class="products-grid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          <div class="product-card">
            <div class="product-card-image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width=300 }}" alt="{{ product.title }}">
              {% endif %}
            </div>
            
            <div class="product-card-info">
              <h3 class="product-card-title">{{ product.title }}</h3>
              
              <p class="product-card-price">{{ product.price | money }}</p>
              
              {% if product.compare_at_price %}
                <p class="product-card-compare">{{ product.compare_at_price | money }}</p>
              {% endif %}
              
              <a href="{{ product.url }}" class="view-product-btn">View Product</a>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p>No products found in this collection.</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .collection-section {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
  }
  
  .collection-header {
    text-align: center;
    margin-bottom: 40px;
  }
  
  .collection-header h1 {
    font-size: 36px;
    color: var(--color-primary);
    margin-bottom: 10px;
  }
  
  .collection-header p {
    font-size: 16px;
    color: var(--color-secondary);
    max-width: 600px;
    margin: 0 auto;
  }
  
  .collection-container {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 30px;
  }
  
  .filters {
    background-color: #f9f9f9;
    padding: 20px;
    border: 1px solid var(--color-primary);
    height: fit-content;
  }
  
  .filters h3 {
    margin-bottom: 15px;
    font-size: 18px;
  }
  
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 30px;
  }
  
  .product-card {
    background-color: white;
    border: 1px solid #ddd;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  
  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(212, 175, 55, 0.2);
  }
  
  .product-card-image {
    overflow: hidden;
    height: 300px;
  }
  
  .product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  
  .product-card:hover .product-card-image img {
    transform: scale(1.05);
  }
  
  .product-card-info {
    padding: 20px;
  }
  
  .product-card-title {
    font-size: 16px;
    color: var(--color-primary);
    margin-bottom: 10px;
    min-height: 40px;
  }
  
  .product-card-price {
    font-size: 18px;
    font-weight: bold;
    color: var(--color-secondary);
    margin-bottom: 5px;
  }
  
  .product-card-compare {
    font-size: 14px;
    text-decoration: line-through;
    color: #999;
    margin-bottom: 15px;
  }
  
  .view-product-btn {
    display: inline-block;
    background-color: var(--color-primary);
    color: var(--color-secondary);
    padding: 10px 20px;
    text-decoration: none;
    font-size: 14px;
    font-weight: bold;
    transition: background-color 0.3s;
  }
  
  .view-product-btn:hover {
    background-color: #b8941f;
  }
  
  @media (max-width: 768px) {
    .collection-container {
      grid-template-columns: 1fr;
    }
    
    .filters {
      display: none;
    }
    
    .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
  }
</style>
