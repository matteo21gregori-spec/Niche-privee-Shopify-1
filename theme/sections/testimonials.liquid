<section class="testimonials">
  <div class="testimonials-header">
    <h2>{{ section.settings.title }}</h2>
    <p>{{ section.settings.subtitle }}</p>
  </div>
  
  <div class="testimonials-grid">
    {% for i in (1..3) %}
      <div class="testimonial-card">
        <div class="stars">
          {% for star in (1..5) %}
            <span class="star">★</span>
          {% endfor %}
        </div>
        
        <p class="testimonial-text">{{ section.settings.testimonial_text | default: "This fragrance is absolutely exceptional. The quality and sophistication are unmatched." }}</p>
        
        <p class="testimonial-author">{{ section.settings.author_name | default: "Luxury Enthusiast" }}</p>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .testimonials {
    max-width: 1200px;
    margin: 60px auto;
    padding: 0 20px;
  }
  
  .testimonials-header {
    text-align: center;
    margin-bottom: 50px;
  }
  
  .testimonials-header h2 {
    font-size: 36px;
    color: var(--color-primary);
    margin-bottom: 10px;
  }
  
  .testimonials-header p {
    font-size: 16px;
    color: var(--color-secondary);
  }
  
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }
  
  .testimonial-card {
    background-color: #f9f9f9;
    padding: 30px;
    border-left: 4px solid var(--color-primary);
    transition: box-shadow 0.3s ease;
  }
  
  .testimonial-card:hover {
    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.1);
  }
  
  .stars {
    margin-bottom: 15px;
  }
  
  .star {
    color: var(--color-primary);
    font-size: 18px;
    margin-right: 5px;
  }
  
  .testimonial-text {
    font-size: 15px;
    color: #333;
    line-height: 1.8;
    margin-bottom: 20px;
    font-style: italic;
  }
  
  .testimonial-author {
    font-size: 14px;
    color: var(--color-secondary);
    font-weight: bold;
  }
  
  @media (max-width: 768px) {
    .testimonials-header h2 {
      font-size: 28px;
    }
    
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What Our Clients Say"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Hear from our satisfied customers"
    },
    {
      "type": "text",
      "id": "testimonial_text",
      "label": "Testimonial Text",
      "default": "This fragrance is absolutely exceptional. The quality and sophistication are unmatched."
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author Name",
      "default": "Luxury Enthusiast"
    }
  ]
}
{% endschema %}
